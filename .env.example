# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.
# Required: MONGODB_URI, ADMIN_EMAIL, ADMIN_PASSWORD (12+ characters), SESSION_SECRET (32+). Everything else can wait.

# ─── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string with a database name, e.g. mongodb://127.0.0.1:27017/mailcheap locally,
# or the Atlas string with /mailcheap before the "?". Use a database of its own.
MONGODB_URI=

# The one dashboard login. The password needs at least 12 characters, or Mailcheap refuses to start.
# Changing either one signs out every session.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the login session and every link in your emails (unsubscribe, confirm, tracking).
# At least 32 random characters, or Mailcheap refuses to start: openssl rand -base64 48
# Changing it later breaks the unsubscribe links in emails already sent.
SESSION_SECRET=

# ─── App ───────────────────────────────────────────────────────────────────────

# Public URL of this app, used in email links and the archive. No trailing slash.
# On Vercel it defaults to the project's production domain; set it once you add your own domain.
APP_URL=http://localhost:3000

# Kill switch: nothing is sent unless this is exactly "true". Leave it off until SES and QStash are set up.
SENDING_ENABLED=false

# ─── Amazon SES (sending) ──────────────────────────────────────────────────────

SES_REGION=us-east-1
# IAM user keys (see the README for the policy). Vercel reserves the AWS_* names, hence SES_*.
# Locally, when these are empty, the AWS SDK uses your default credentials (~/.aws).
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Configuration set whose event destination publishes to the SNS topic below.
SES_CONFIGURATION_SET=
# SNS topic ARN that receives bounces, complaints and deliveries at /api/webhooks/ses.
SES_SNS_TOPIC_ARN=

# Emails per second across all sends, 1 to 14 (default 10). A free Atlas cluster (M0) handles about 6.
SEND_RATE_PER_SECOND=

# ─── Upstash QStash (background sending and scheduling) ────────────────────────

# From the Upstash console > QStash. QStash calls APP_URL/api/jobs/*, so APP_URL must be public.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only for a QStash region other than the default, or a local QStash dev server (npx @upstash/qstash-cli dev).
QSTASH_URL=

# ─── Optional ──────────────────────────────────────────────────────────────────

# Archive domains: news.example.com=weekly serves the "weekly" newsletter's archive at that domain.
# Comma-separated for several newsletters. Point the domain at this app first. It's the safer setup:
# issue HTML then never shares the dashboard's origin, and APP_URL/archive/weekly redirects there.
ARCHIVE_HOSTS=

# Upstash Redis: rate limits shared by every server instance. Without it, the same limits are counted
# in each instance's memory, which still stops a script hammering a form.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Image uploads in the editor. Without storage, uploads are off; HTML and Markdown campaigns
# (API, HTML editor) can still use images hosted anywhere. Pick one:
#
# Amazon S3 (works on any host): a bucket whose images/ folder is publicly readable. Uploads reuse the
# SES_* keys, so that IAM user also needs s3:PutObject on arn:aws:s3:::<bucket>/images/*.
S3_BUCKET=
# Defaults to SES_REGION.
S3_REGION=
# Optional: a CDN or custom domain in front of the bucket, without a trailing slash.
S3_PUBLIC_URL=
#
# Vercel Blob: set automatically when you connect a Blob store on Vercel.
BLOB_READ_WRITE_TOKEN=

# Alerts by email to ADMIN_EMAIL (spam complaints, paused sends, signup floods, rate limiter outages, and
# every login, new API key and send), sent through SES from this address on a verified domain,
# e.g. Mailcheap <alerts@mail.example.com>. Empty: logs only.
ALERT_FROM=

# Optional. The sender of password-reset emails (and, later, invitations), on a verified domain. Empty:
# ALERT_FROM is used. Without either, a password reset can only be logged, not emailed.
PLATFORM_FROM=

# ─── GTM agent (off by default) ─────────────────────────────────────────────────

# The GTM agent module: finds posts worth replying to, drafts replies in your voice, and tracks the signups
# that follow. Nothing in it runs — no pages, no scheduled scan, no AI calls — unless this is exactly "true".
# Every table it owns is named gtm_*, so switching it off leaves the newsletter product untouched.
GTM_ENABLED=false

# Anthropic API key, from console.anthropic.com. Without it the module loads but every AI step says so
# instead of failing silently. Each call is logged to gtm_ai_usage with its tokens and estimated cost.
ANTHROPIC_API_KEY=

# Only to use a model other than the default (claude-opus-5-5). A model that lib/gtm/config.js has no price
# for still works, but its calls are logged with an empty cost — add it to the price table first.
GTM_AI_MODEL=
